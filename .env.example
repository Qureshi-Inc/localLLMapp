# CaseVault — Environment variables
# Copy to .env and fill in for your deployment.

# ── Application ────────────────────────────────────────────────
APP_NAME=CaseVault
APP_VERSION=0.1.0
DEBUG=false

# ── Server ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/casevault

# ── Vector store ───────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=document_embeddings

# ── LLM ────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
LLM_MODEL=gpt-oss-20b
EMBEDDING_MODEL=nomic-embed-text

# ── Object Storage ─────────────────────────────────────────────
# Options: localfs | minio
STORAGE_MODE=localfs
STORAGE_PATH=/var/lib/casevault/storage

# MinIO (only used when STORAGE_MODE=minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=casevault-minio-key
MINIO_SECRET_KEY=casevault-minio-secret
MINIO_BUCKET=casevault-documents

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
