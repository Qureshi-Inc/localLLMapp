# Copy to .env (git-ignored) and fill in real values. Never commit secrets.

# Postgres password used by both the app and the postgres container.
POSTGRES_PASSWORD=

# HMAC key that signs session cookies. MUST be random and >= 32 chars.
# The app refuses to start with a placeholder/weak value.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Only needed if you run the app outside docker-compose (compose builds this
# from POSTGRES_PASSWORD automatically):
# DATABASE_URL=postgresql://socialplanner:<password>@localhost:5432/socialplanner
